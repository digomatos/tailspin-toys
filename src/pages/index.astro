---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getAllCategories, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length > 0 && (
        <form
          id="game-filters"
          class="mb-6 bg-slate-800/60 border border-slate-700/50 rounded-xl p-4 flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
          aria-label="Filter games"
          data-testid="game-filters"
        >
          <fieldset class="min-w-0">
            <legend class="text-sm font-medium text-slate-300 mb-2">Categories</legend>
            <div class="flex flex-wrap gap-2">
              {categories.map((category) => (
                <label class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/50 px-3 py-1.5 text-sm text-slate-200 cursor-pointer has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-500 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-600/20">
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    class="h-4 w-4 accent-blue-500 focus:outline-none"
                    data-testid={`filter-category-${category.id}`}
                  />
                  {category.name}
                </label>
              ))}
            </div>
          </fieldset>

          <div class="flex items-end gap-3">
            <div>
              <label for="publisher-filter" class="block text-sm font-medium text-slate-300 mb-2">Publisher</label>
              <select
                id="publisher-filter"
                name="publisher"
                class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="filter-publisher"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </div>
            <button
              type="reset"
              class="rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-200 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="filter-clear"
            >
              Clear filters
            </button>
          </div>
        </form>
      )}

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <p class="sr-only" role="status" aria-live="polite" id="filter-status" data-testid="filter-status"></p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div id="filter-empty" class="hidden" data-testid="filter-empty">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  import { cardMatchesFilters } from '../lib/filters';

  const form = document.getElementById('game-filters') as HTMLFormElement | null;
  if (form) {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const empty = document.getElementById('filter-empty');
    const status = document.getElementById('filter-status');

    /** Shows or hides cards based on the current form state and updates the status message. */
    const apply = (): void => {
      const categoryIds = Array.from(
        form.querySelectorAll<HTMLInputElement>('input[name="category"]:checked'),
      ).map((input) => input.value);
      const publisherId = (form.elements.namedItem('publisher') as HTMLSelectElement).value;

      let visible = 0;
      for (const card of cards) {
        const show = cardMatchesFilters(
          { categoryId: card.dataset.categoryId, publisherId: card.dataset.publisherId },
          { categoryIds, publisherId },
        );
        card.hidden = !show;
        if (show) visible++;
      }
      empty?.classList.toggle('hidden', visible > 0);
      if (status) status.textContent = `${visible} of ${cards.length} games shown`;
    };

    form.addEventListener('change', apply);
    form.addEventListener('reset', () => setTimeout(apply));
    form.addEventListener('submit', (event) => event.preventDefault());
  }
</script>

